{
  "manifest_version": 3,
  "name": "Shopkit Product Builder",
  "version": "1.0.0",
  "description": "AI-powered product form filler for Shopkit admin",
  "permissions": ["storage"],
  "host_permissions": ["https://api.openai.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Configurar Shopkit Product Builder"
  },
  "content_scripts": [
    {
      "matches": ["https://*.shopk.it/admin/products/create"],
      "js": ["content.js"],
      "css": ["panel.css"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
